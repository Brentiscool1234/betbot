[Unit]
Description=EDGE private browser dashboard
After=edge-collector.service

[Service]
Type=simple
User=edge
Group=edge
WorkingDirectory=/opt/edge
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u -m edge.gui --directory /var/lib/edge/prospective --port 8765
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
