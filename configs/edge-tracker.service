[Unit]
Description=Update EDGE experimental paper match tracker
After=edge-collector.service

[Service]
Type=oneshot
User=edge
Group=edge
WorkingDirectory=/opt/edge
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m edge.tracker --directory /var/lib/edge/prospective
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/edge
